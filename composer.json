    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.3"
    },
    "autoload-dev": {
        "files": [
            "triage.php",
            "logic/mpu_helper.php",
            "logic/request.php",
            "logic/validator.php",
            "config/allowed_values.php"
        ]
    },
    "scripts": {
